# Groq API Key for CodeLens AI
# Get your key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Optional model selection (defaults to openai/gpt-oss-120b and openai/gpt-oss-20b)
# GROQ_MODEL=openai/gpt-oss-120b
# GROQ_FALLBACK_MODEL=openai/gpt-oss-20b

# Firebase Authentication Configuration
# Project: vbus-b49d6
FIREBASE_PROJECT_ID=vbus-b49d6
# Optional: Set your Web Client API Key and App ID from Firebase Console -> Project Settings -> General -> Your apps
# FIREBASE_API_KEY=your_firebase_api_key
# FIREBASE_APP_ID=your_firebase_app_id
# Optional: Path to Firebase Admin service account key JSON (keep on server only, never in frontend)
# FIREBASE_SERVICE_ACCOUNT_KEY=backend/serviceAccountKey.json

# Memory and Performance Configuration (Render 512MB RAM optimization)
INDEXING_CHUNK_BATCH_SIZE=16
EMBEDDING_BATCH_SIZE=16
OMP_NUM_THREADS=1
MKL_NUM_THREADS=1
TOKENIZERS_PARALLELISM=false
HF_HUB_OFFLINE=0
