{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://codelense-backend.onrender.com/api/$1"
    },
    {
      "source": "/login",
      "destination": "/login.html"
    },
    {
      "source": "/index",
      "destination": "/index.html"
    }
  ]
}
